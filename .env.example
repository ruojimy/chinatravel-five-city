# Copy to `.env` (git-ignored) and fill in your own credentials.
# The suite never ships a real key; scripts read env first, then `.secrets/`.

# --- Amap Web Service (https://console.amap.com) ---------------------------
AMAP_KEY=
# Optional pool used by the Xi'an price/POI backfill scripts (comma separated).
AMAP_KEYS=

# --- Baidu Place API 3.0 (SN signature) ------------------------------------
BAIDU_AK=
BAIDU_SK=

# --- DeepSeek (optional: dynamic retrieval / translation fallback) ---------
DEEPSEEK_API_KEY=

# --- Path overrides (defaults are siblings of the repo) --------------------
# SHORTTRIP_LOCAL=C:/path/to/shorttrip-local
# SHORTTRIP_RUNS=C:/path/to/shorttrip-runs
# SHORTTRIP_UPSTREAM=C:/path/to/ShortTrip-upstream

# --- Local inference budget (see README §2.3) ------------------------------
SHORTTRIP_NP=6
SHORTTRIP_CTX=16384
SHORTTRIP_WORKERS=6
