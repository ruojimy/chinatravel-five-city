{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "people_number": {
      "type": "integer"
    },
    "start_city": {
      "type": "string"
    },
    "target_city": {
      "type": "string"
    },
    "itinerary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "integer"
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "airplane",
                    "attraction",
                    "lunch",
                    "dinner",
                    "breakfast",
                    "accommodation",
                    "train"
                  ]
                },
                "start_time": {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$"
                },
                "end_time": {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$"
                },
                "cost": {
                  "type": "number"
                },
                "price": {
                  "type": "number"
                },
                "tickets": {
                  "type": "integer",
                  "minimum": 1
                },
                "position": {
                  "type": "string",
                  "description": "Exact catalogue entity name; describe uncertainty separately, not in this field."
                },
                "transports": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "string"
                      },
                      "end": {
                        "type": "string"
                      },
                      "mode": {
                        "type": "string",
                        "enum": [
                          "walk",
                          "metro",
                          "taxi"
                        ]
                      },
                      "start_time": {
                        "type": "string",
                        "pattern": "^\\d{2}:\\d{2}$"
                      },
                      "end_time": {
                        "type": "string",
                        "pattern": "^\\d{2}:\\d{2}$"
                      },
                      "cost": {
                        "type": "number"
                      },
                      "price": {
                        "type": "number"
                      },
                      "distance": {
                        "type": "number"
                      },
                      "tickets": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "cars": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Taxi vehicles; preserve the complete value returned by goto."
                      }
                    },
                    "required": [
                      "start",
                      "end",
                      "mode",
                      "start_time",
                      "end_time",
                      "price",
                      "cost",
                      "distance"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "mode": {
                              "const": "taxi"
                            }
                          },
                          "required": [
                            "mode"
                          ]
                        },
                        "then": {
                          "required": [
                            "cars"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "mode": {
                              "const": "metro"
                            }
                          },
                          "required": [
                            "mode"
                          ]
                        },
                        "then": {
                          "required": [
                            "tickets"
                          ]
                        }
                      }
                    ]
                  },
                  "description": "Full goto legs into this activity, including cars for taxis and tickets for metro; arrival must be no later than activity start."
                },
                "room_type": {
                  "type": "integer",
                  "description": "Optional bed-count proxy; omit when unverified. It is not evidence of an actual bookable room type."
                },
                "rooms": {
                  "type": "integer",
                  "minimum": 1
                },
                "FlightID": {
                  "type": "string"
                },
                "TrainID": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "start_time",
                "end_time",
                "cost",
                "price",
                "transports"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "airplane",
                          "train"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "start",
                      "end"
                    ],
                    "not": {
                      "required": [
                        "position"
                      ]
                    }
                  },
                  "else": {
                    "required": [
                      "position"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "start"
                          ]
                        },
                        {
                          "required": [
                            "end"
                          ]
                        },
                        {
                          "required": [
                            "FlightID"
                          ]
                        },
                        {
                          "required": [
                            "TrainID"
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "airplane"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "FlightID"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "train"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "TrainID"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "accommodation"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "rooms"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "train",
                          "airplane",
                          "attraction"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "tickets"
                    ]
                  }
                }
              ]
            }
          }
        },
        "required": [
          "day",
          "activities"
        ]
      }
    }
  },
  "required": [
    "people_number",
    "start_city",
    "target_city",
    "itinerary"
  ],
  "description": "Conditional static benchmark: only an unknown attraction ticket may be assigned zero by user authorization; do not invent other prices. Historical and offline estimates are not current availability."
}
